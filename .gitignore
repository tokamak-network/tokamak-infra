# TLS/SSL certificates and private keys
*.key
*.pem
*.crt
*.p12
*.pfx

# Terraform state (contains sensitive infrastructure data)
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.d/
.terraform/
.terraform.lock.hcl

# Environment variables
.env
.env.local
.env.*.local

# Secrets
secrets/
*.secret
credentials.json

# Secret-bearing manifests — values must come from ExternalSecret / AWS Secrets Manager,
# never inline. These names must never carry real values in git (see docs/security/REMEDIATION.md).
**/secret.env
**/secret-cert.yaml

# git-filter-repo replacement patterns (contains raw secrets; delete after history rewrite)
.git-history-replacements.txt
